{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X4B lifecycle import 1.0",
  "description": "A complete, sourced support observation per catalogue key, version and source identity. Semantic date ordering, UTF-8 byte limits and catalogue existence are also checked by X4B.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dry_run": {"type": "boolean", "default": true},
    "expected_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "records": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/record"}}
  },
  "allOf": [{
    "if": {"required": ["dry_run"], "properties": {"dry_run": {"const": false}}},
    "then": {"required": ["expected_digest"], "properties": {"expected_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
  }],
  "$defs": {
    "date": {"type": ["string", "null"], "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "id"],
      "properties": {
        "system": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$", "description": "The server additionally limits this field to 128 UTF-8 bytes and rejects surrounding whitespace."},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_key", "version", "status", "source", "observed_at", "evidence"],
      "properties": {
        "type_key": {"type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[A-Za-z0-9_-]+$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},
        "version_match": {"type": "string", "enum": ["exact", "release_prefix"], "default": "exact"},
        "status": {"type": "string", "enum": ["supported", "deprecated", "end_of_support", "unknown"]},
        "support_end": {"$ref": "#/$defs/date"},
        "extended_support_end": {"$ref": "#/$defs/date"},
        "source": {"$ref": "#/$defs/source"},
        "observed_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]+$"}
      }
    }
  }
}
