# AppControl Docker Compose configuration
# Copy to .env, replace every CHANGE_* value, and keep the file private.

# Images
APPCONTROL_VERSION=latest
APPCONTROL_IMAGE_PREFIX=ghcr.io/xcomponent/appcontrol

# Required secrets
POSTGRES_PASSWORD=CHANGE_POSTGRES_PASSWORD
JWT_SECRET=CHANGE_JWT_SECRET

# Initial administrator, created only when the database is empty
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD
SEED_ADMIN_DISPLAY_NAME=Admin
SEED_ORG_NAME=Default Organization
SEED_ORG_SLUG=default

# Database and exposed ports
POSTGRES_DB=appcontrol
POSTGRES_USER=appcontrol
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=8080
GATEWAY_PORT=4443

# Optional SSO
# OIDC_DISCOVERY_URL=https://login.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=appcontrol
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://appcontrol.example.com/api/v1/auth/oidc/callback
# SAML_IDP_SSO_URL=https://idp.example.com/sso
# SAML_IDP_CERT=/path/to/idp-cert.pem
# SAML_SP_ENTITY_ID=https://appcontrol.example.com

# Optional public URLs shown in enrollment commands
# PUBLIC_GATEWAY_URL=wss://gateway.example.com:4443
# PUBLIC_BACKEND_URL=wss://backend.example.com/ws/gateway

CORS_ORIGINS=
JWT_ISSUER=appcontrol
RUST_LOG=info
